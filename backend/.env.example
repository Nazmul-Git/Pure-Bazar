# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/purebazarv1_test?retryWrites=true&w=majority&appName=Cluster0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Super Admin Default Credentials
SUPER_ADMIN_EMAIL=admin@purebazar.local
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS (required in production)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (needed for correct rate limiting by IP)
TRUST_PROXY=
# Optional: failed login attempts per 15 minutes per IP+email, and API requests per minute per IP
LOGIN_RATE_MAX=10
API_RATE_MAX=600